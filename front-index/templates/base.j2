<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Vidéothèque{% endblock %}</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    .affiche { aspect-ratio: 2 / 3; object-fit: cover; }
    .affiche-vide { aspect-ratio: 2 / 3; }
    .miniature { width: 48px; aspect-ratio: 2 / 3; object-fit: cover; }
    input:focus, select:focus { outline: 2px solid #2563eb; outline-offset: 1px; }
    @keyframes fade-up {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes card-in {
      from { opacity: 0; transform: translateY(14px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-up { animation: fade-up 450ms ease-out both; }
    .film-card { animation: card-in 450ms ease-out both; transition: transform 180ms ease, box-shadow 180ms ease; }
    .film-card:hover { transform: translateY(-4px); box-shadow: 0 8px 18px rgb(15 23 42 / 12%); }
    .poster-link { display: block; overflow: hidden; }
    .poster-link img { transition: transform 220ms ease; }
    .poster-link:hover img { transform: scale(1.04); }
    .ui-action { transition: transform 150ms ease, background-color 150ms ease, box-shadow 150ms ease; }
    .ui-action:hover { transform: translateY(-1px); box-shadow: 0 3px 8px rgb(15 23 42 / 14%); }
    form[role="search"] input, form[role="search"] select { transition: border-color 150ms ease, box-shadow 150ms ease; }
    form[role="search"] input:focus, form[role="search"] select:focus { box-shadow: 0 0 0 3px rgb(37 99 235 / 14%); }
    @media (prefers-reduced-motion: reduce) {
      .animate-fade-up, .film-card { animation: none; }
      .film-card, .poster-link img, .ui-action, form[role="search"] input, form[role="search"] select { transition: none; }
    }
  </style>
</head>
<body class="min-h-screen bg-slate-100 text-slate-900">
  <nav class="mb-8 rounded-b-md border-b border-slate-300 bg-white">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-4 px-4 py-3">
      <a class="mr-4 text-lg font-semibold text-slate-900" href="{{ url_for('index') }}">Vidéothèque</a>
      {% if connecte %}
      <ul class="mr-auto flex gap-4 text-sm">
        <li><a class="py-2 hover:text-blue-600 {{ 'font-semibold text-blue-600' if request.endpoint == 'index' }}" href="{{ url_for('index') }}">Catalogue</a></li>
        <li><a class="py-2 hover:text-blue-600 {{ 'font-semibold text-blue-600' if request.endpoint == 'videotheque' }}" href="{{ url_for('videotheque') }}">Ma vidéothèque</a></li>
      </ul>
      <form method="post" action="{{ url_for('logout') }}" class="flex items-center gap-4 text-sm">
        {% if admin %}<a class="hover:text-blue-600" href="{{ url_for('admin') }}">Administration</a>{% endif %}
        <a class="hover:text-blue-600" href="{{ url_for('account') }}">Mon compte</a>
        <button class="text-slate-600 hover:text-blue-600">Déconnexion</button>
      </form>
      {% else %}
      <div class="ml-auto flex gap-4 text-sm">
        <a class="hover:text-blue-600" href="{{ url_for('login') }}">Connexion</a>
        <a class="font-medium text-blue-600 hover:text-blue-800" href="{{ url_for('register') }}">Inscription</a>
      </div>
      {% endif %}
    </div>
  </nav>

  <main class="mx-auto max-w-7xl px-4 pb-12">
    {% if erreur %}<div class="mb-6 border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">{{ erreur }}</div>{% endif %}
    {% block content %}{% endblock %}
  </main>
</body>
</html>
