<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Vidéothèque{% endblock %}</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    .affiche { aspect-ratio: 2 / 3; object-fit: cover; }
    .affiche-vide { aspect-ratio: 2 / 3; }
    .miniature { width: 48px; aspect-ratio: 2 / 3; object-fit: cover; }
  </style>
</head>
<body class="min-h-screen bg-slate-100 text-slate-900">
  <nav class="mb-8 bg-slate-900 text-white shadow">
    <div class="mx-auto flex max-w-7xl items-center gap-6 px-4 py-4">
      <a class="font-semibold" href="{{ url_for('index') }}">Vidéothèque</a>
      {% if connecte %}
      <ul class="mr-auto flex gap-4 text-sm text-slate-300">
        <li><a class="{{ 'font-semibold text-white' if request.endpoint == 'index' }}" href="{{ url_for('index') }}">Catalogue</a></li>
        <li><a class="{{ 'font-semibold text-white' if request.endpoint == 'videotheque' }}" href="{{ url_for('videotheque') }}">Ma vidéothèque</a></li>
      </ul>
      <form method="post" action="{{ url_for('logout') }}" class="flex gap-2">
        <a class="rounded border border-slate-500 px-3 py-1.5 text-sm hover:bg-slate-800" href="{{ url_for('account') }}">Mon compte</a>
        <button class="rounded border border-slate-500 px-3 py-1.5 text-sm hover:bg-slate-800">Déconnexion</button>
      </form>
      {% else %}
      <div class="ml-auto flex gap-2">
        <a class="rounded border border-slate-500 px-3 py-1.5 text-sm hover:bg-slate-800" href="{{ url_for('login') }}">Connexion</a>
        <a class="rounded bg-blue-600 px-3 py-1.5 text-sm hover:bg-blue-500" href="{{ url_for('register') }}">Inscription</a>
      </div>
      {% endif %}
    </div>
  </nav>

  <main class="mx-auto max-w-7xl px-4 pb-12">
    {% if erreur %}<div class="mb-4 rounded border border-red-200 bg-red-50 px-4 py-3 text-red-800" role="alert">{{ erreur }}</div>{% endif %}
    {% block content %}{% endblock %}
  </main>
</body>
</html>
