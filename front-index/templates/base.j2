<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Vidéothèque{% endblock %}</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    .affiche { aspect-ratio: 2 / 3; object-fit: cover; }
    .affiche-vide { aspect-ratio: 2 / 3; }
    .miniature { width: 48px; aspect-ratio: 2 / 3; object-fit: cover; }
    input:focus, select:focus { outline: 2px solid #2563eb; outline-offset: 1px; }
    @keyframes fade-up {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes card-in {
      from { opacity: 0; transform: translateY(14px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-up { animation: fade-up 450ms ease-out both; }
    .film-card { animation: card-in 450ms ease-out both; transition: transform 180ms ease, box-shadow 180ms ease; }
    .film-card:hover { transform: translateY(-4px); box-shadow: 0 8px 18px rgb(15 23 42 / 12%); }
    .poster-link { display: block; overflow: hidden; }
    .poster-link img { transition: transform 220ms ease; }
    .poster-link:hover img { transform: scale(1.04); }
    .ui-action { transition: transform 150ms ease, background-color 150ms ease, box-shadow 150ms ease; }
    .ui-action:hover { transform: translateY(-1px); box-shadow: 0 3px 8px rgb(15 23 42 / 14%); }
    form[role="search"] input, form[role="search"] select { transition: border-color 150ms ease, box-shadow 150ms ease; }
    form[role="search"] input:focus, form[role="search"] select:focus { box-shadow: 0 0 0 3px rgb(37 99 235 / 14%); }
    @media (prefers-reduced-motion: reduce) {
      .animate-fade-up, .film-card { animation: none; }
      .film-card, .poster-link img, .ui-action, form[role="search"] input, form[role="search"] select { transition: none; }
    }
  </style>
</head>
<body class="min-h-screen bg-slate-100 text-slate-900">
  <nav class="mb-8 rounded-b-md border-b border-slate-300 bg-white">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between px-4 py-3">
      <div class="flex items-center">
        <a class="mr-6 text-lg font-semibold text-slate-900" href="{{ url_for('index') }}">Vidéothèque</a>
        {% if connecte %}
        <ul class="flex gap-4 text-sm">
          <li><a class="py-2 hover:text-blue-600 {{ 'font-semibold text-blue-600' if request.endpoint == 'index' }}" href="{{ url_for('index') }}">Catalogue</a></li>
          <li><a class="py-2 hover:text-blue-600 {{ 'font-semibold text-blue-600' if request.endpoint == 'videotheque' }}" href="{{ url_for('videotheque') }}">Ma vidéothèque</a></li>
        </ul>
        {% endif %}
      </div>

      {% if connecte %}
      <div class="relative">
        <button id="dropdownDividerButton" class="inline-flex items-center justify-center text-white bg-blue-600 hover:bg-blue-700 font-medium rounded-lg text-sm px-4 py-2.5 focus:outline-none focus:ring-4 focus:ring-blue-300 transition" type="button">
          Menu 
          <svg class="w-4 h-4 ms-1.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 9-7 7-7-7"/></svg>
        </button>

        <!-- Dropdown menu -->
        <div id="dropdownDivider" class="absolute right-0 mt-2 z-10 hidden bg-white border border-slate-200 rounded-lg divide-y divide-slate-200 shadow-lg w-44">
          <ul class="p-2 text-sm text-slate-700 font-medium" aria-labelledby="dropdownDividerButton">
            {% if admin %}
            <li><a class="inline-flex items-center w-full p-2 hover:bg-slate-100 hover:text-slate-900 rounded" href="{{ url_for('admin') }}">Administration</a></li>
            {% endif %}
            <li><a class="inline-flex items-center w-full p-2 hover:bg-slate-100 hover:text-slate-900 rounded" href="{{ url_for('account') }}">Mon compte</a></li>
          </ul>
          <div class="p-2 text-sm text-slate-700 font-medium">
            <form method="post" action="{{ url_for('logout') }}">
              <button type="submit" class="inline-flex items-center w-full p-2 hover:bg-red-50 hover:text-red-600 rounded text-left text-red-500">Déconnexion</button>
            </form>
          </div>
        </div>
      </div>
      {% else %}
      <div class="flex gap-4 text-sm">
        <a class="hover:text-blue-600" href="{{ url_for('login') }}">Connexion</a>
        <a class="font-medium text-blue-600 hover:text-blue-800" href="{{ url_for('register') }}">Inscription</a>
      </div>
      {% endif %}
    </div>
  </nav>

  <main class="mx-auto max-w-7xl px-4 pb-12">
    {% if erreur %}<div class="mb-6 border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">{{ erreur }}</div>{% endif %}
    {% block content %}{% endblock %}
  </main>

  <!-- Script pour gérer l'ouverture/fermeture du menu déroulant -->
  <script>
    const button = document.getElementById('dropdownDividerButton');
    const menu = document.getElementById('dropdownDivider');

    if (button && menu) {
      button.addEventListener('click', (e) => {
        e.stopPropagation();
        menu.classList.toggle('hidden');
      });

      // Fermer le menu si l'on clique en dehors
      document.addEventListener('click', (e) => {
        if (!menu.contains(e.target) && !button.contains(e.target)) {
          menu.classList.add('hidden');
        }
      });
    }
  </script>
</body>
</html>