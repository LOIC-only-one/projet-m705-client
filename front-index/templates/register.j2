{% extends "base.j2" %}
{% block title %}Inscription · Vidéothèque{% endblock %}
{% block content %}
<div class="mx-auto max-w-md">
  <div class="rounded-lg bg-white p-6 shadow">
        <h1 class="mb-4 text-xl font-semibold">Inscription</h1>
        <form method="post">
          <div class="mb-4">
            <label for="username" class="mb-1 block text-sm font-medium">Nom d'utilisateur</label>
            <input class="w-full rounded border border-slate-300 px-3 py-2" id="username" name="username" value="{{ form.username }}" required
                   pattern="[A-Za-z0-9_.\-]{3,50}" autocomplete="username">
            <div class="mt-1 text-sm text-slate-500">3 à 50 caractères : lettres, chiffres, _ . -</div>
          </div>
          <div class="mb-4">
            <label for="email" class="mb-1 block text-sm font-medium">Email</label>
            <input type="email" class="w-full rounded border border-slate-300 px-3 py-2" id="email" name="email" value="{{ form.email }}" required maxlength="255" autocomplete="email">
          </div>
          <div class="mb-4">
            <label for="password" class="mb-1 block text-sm font-medium">Mot de passe</label>
            <input type="password" class="w-full rounded border border-slate-300 px-3 py-2" id="password" name="password" required minlength="12" autocomplete="new-password">
            <div class="mt-1 text-sm text-slate-500">12 caractères minimum.</div>
          </div>
          <div class="mb-4">
            <label for="birthdate" class="mb-1 block text-sm font-medium">Date de naissance</label>
            <input type="date" class="w-full rounded border border-slate-300 px-3 py-2" id="birthdate" name="birthdate" value="{{ form.birthdate }}" required>
          </div>
          <button type="submit" class="w-full rounded bg-blue-600 px-4 py-2 text-white hover:bg-blue-500">Créer le compte</button>
        </form>
        <p class="mt-4 text-center text-sm">Déjà inscrit ? <a class="text-blue-600 hover:underline" href="{{ url_for('login') }}">Connexion</a></p>
  </div>
</div>
{% endblock %}
