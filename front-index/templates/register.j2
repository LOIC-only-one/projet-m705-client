{% extends "base.j2" %}
{% block title %}Inscription · Vidéothèque{% endblock %}
{% block content %}
<div class="row justify-content-center">
  <div class="col-md-5">
    <div class="card shadow-sm">
      <div class="card-body">
        <h1 class="h4 mb-3">Inscription</h1>
        <form method="post">
          <div class="mb-3">
            <label for="username" class="form-label">Nom d'utilisateur</label>
            <input class="form-control" id="username" name="username" value="{{ form.username }}" required
                   pattern="[A-Za-z0-9_.\-]{3,50}" autocomplete="username">
            <div class="form-text">3 à 50 caractères : lettres, chiffres, _ . -</div>
          </div>
          <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input type="email" class="form-control" id="email" name="email" value="{{ form.email }}" required maxlength="255" autocomplete="email">
          </div>
          <div class="mb-3">
            <label for="password" class="form-label">Mot de passe</label>
            <input type="password" class="form-control" id="password" name="password" required minlength="12" autocomplete="new-password">
            <div class="form-text">12 caractères minimum.</div>
          </div>
          <div class="mb-3">
            <label for="birthdate" class="form-label">Date de naissance</label>
            <input type="date" class="form-control" id="birthdate" name="birthdate" value="{{ form.birthdate }}" required>
          </div>
          <button type="submit" class="btn btn-primary w-100">Créer le compte</button>
        </form>
        <p class="mt-3 mb-0 text-center">Déjà inscrit ? <a href="{{ url_for('login') }}">Connexion</a></p>
      </div>
    </div>
  </div>
</div>
{% endblock %}
