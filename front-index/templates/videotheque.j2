{% extends "base.j2" %}
{% block title %}Ma vidéothèque · Vidéothèque{% endblock %}
{% macro ligne_film(film) %}
  {% if film.affiche %}<img src="{{ film.affiche }}" class="miniature rounded" alt="" loading="lazy">{% endif %}
  <div class="flex-1">
    <a class="font-semibold hover:text-blue-600" href="{{ url_for('film', film_id=film.id) }}">{{ film.titre }}</a>
    <div class="text-sm text-slate-500">{{ film.annee }}</div>
  </div>
{% endmacro %}
{% block content %}
<h1 class="mb-6 text-2xl font-semibold">Ma vidéothèque</h1>
<div class="grid gap-8 lg:grid-cols-2">
  <section>
    <h2 class="mb-3 text-lg font-semibold">Mes emprunts en cours <span class="text-sm font-normal text-slate-500">{{ en_cours | length }}/5</span></h2>
    {% if en_cours %}
    <ul class="overflow-hidden rounded-md border border-slate-300 bg-white">
      {% for e in en_cours %}
      <li class="flex flex-wrap items-center gap-3 border-b border-slate-200 p-4 last:border-0 {{ 'bg-red-50' if e.en_retard }}">
        {{ ligne_film(e.film) }}
        <span class="text-right text-sm {{ 'font-semibold text-red-600' if e.en_retard else 'text-slate-500' }}">
          {% if e.en_retard %}En retard depuis le{% else %}À rendre avant le{% endif %}<br>{{ e.date_retour_prevue }}
        </span>
        <div class="flex gap-2">
          {% if not e.prolonge and not e.en_retard %}
          <form method="post" action="{{ url_for('prolonger', id=e.id) }}">
            <button class="rounded border border-slate-300 px-3 py-1.5 text-sm hover:bg-slate-50" title="+7 jours, une seule fois">Prolonger</button>
          </form>
          {% endif %}
          <form method="post" action="{{ url_for('rendre', id=e.id) }}">
            <button class="rounded bg-blue-600 px-3 py-1.5 text-sm text-white hover:bg-blue-500">Rendre</button>
          </form>
        </div>
      </li>
      {% endfor %}
    </ul>
    {% else %}
    <p class="text-slate-500">Aucun emprunt. <a class="text-blue-600 hover:underline" href="{{ url_for('catalogue', dispo=1) }}">Voir les films disponibles</a></p>
    {% endif %}

    {% if historique %}
    <details class="mt-6">
      <summary class="font-semibold">Historique ({{ historique | length }})</summary>
      <ul class="mt-2 divide-y divide-slate-200">
        {% for e in historique %}
        <li class="flex items-center gap-3 py-3">
          {{ ligne_film(e.film) }}
          <span class="text-right text-sm text-slate-500">Du {{ e.date_emprunt }}<br>au {{ e.date_retour }}</span>
        </li>
        {% endfor %}
      </ul>
    </details>
    {% endif %}
  </section>

  <section>
    <h2 class="mb-3 text-lg font-semibold">Mes films <span class="text-sm font-normal text-slate-500">{{ exemplaires | length }}</span></h2>
    {% if exemplaires %}
    <ul class="overflow-hidden rounded-md border border-slate-300 bg-white">
      {% for ex in exemplaires %}
      <li class="flex items-center gap-3 border-b border-slate-200 p-4 last:border-0">
        {{ ligne_film(ex.film) }}
        {% if ex.prete_jusquau %}
        <span class="text-xs font-medium {{ 'text-red-700' if ex.en_retard else 'text-yellow-700' }}">
          {{ 'Retour en retard' if ex.en_retard else 'Prêté' }} · {{ ex.prete_jusquau }}
        </span>
        {% else %}
        <span class="text-xs font-medium text-green-700">Chez moi</span>
        <form method="post" action="{{ url_for('supprimer_exemplaire', id=ex.id) }}">
          <button class="rounded border border-red-300 px-3 py-1.5 text-sm text-red-700 hover:bg-red-50">Retirer</button>
        </form>
        {% endif %}
      </li>
      {% endfor %}
    </ul>
    {% else %}
    <p class="text-slate-500">Vous n'avez déclaré aucun film. Cliquez sur « J'ai ce film » dans le <a class="text-blue-600 hover:underline" href="{{ url_for('catalogue') }}">catalogue</a>.</p>
    {% endif %}
  </section>
</div>
{% endblock %}
