{% extends "base.j2" %}
{% block content %}
{% if not connecte %}
<div class="p-5 bg-white rounded shadow-sm">
  <h1 class="display-6">Bienvenue à la vidéothèque</h1>
  <p class="lead text-muted">Déclarez les films que vous possédez et empruntez ceux des autres membres.</p>
  <a class="btn btn-primary" href="{{ url_for('register') }}">Créer un compte</a>
  <a class="btn btn-outline-secondary" href="{{ url_for('login') }}">Se connecter</a>
</div>
{% else %}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
  <h1 class="h3 m-0">Catalogue</h1>
  <form method="get" class="d-flex gap-2" role="search">
    <input type="search" name="q" value="{{ q }}" class="form-control" placeholder="Rechercher un titre…" aria-label="Rechercher un titre" maxlength="100">
    <button class="btn btn-primary">Rechercher</button>
    {% if q %}<a class="btn btn-outline-secondary" href="{{ url_for('index') }}">Effacer</a>{% endif %}
  </form>
</div>

{% if films %}
<div class="row row-cols-2 row-cols-md-3 row-cols-lg-5 g-4">
  {% for film in films %}
  <article class="col">
    <div class="card h-100 shadow-sm">
      {% if film.affiche %}
      <img src="{{ film.affiche }}" class="card-img-top affiche" alt="Affiche de {{ film.titre }}" loading="lazy">
      {% else %}
      <div class="card-img-top affiche-vide bg-secondary-subtle d-flex align-items-center justify-content-center text-muted">Pas d'affiche</div>
      {% endif %}
      <div class="card-body d-flex flex-column">
        <h2 class="h6 card-title mb-1">{{ film.titre }}</h2>
        <p class="card-text text-muted small mb-2">{{ film.annee }}{% if film.genres %} · {{ film.genres[:2] | join(', ') }}{% endif %}</p>
        <p class="mb-3">
          {% if film.disponibles %}
          <span class="badge text-bg-success">{{ film.disponibles }} disponible{{ 's' if film.disponibles > 1 }}</span>
          {% else %}
          <span class="badge text-bg-secondary">Indisponible</span>
          {% endif %}
        </p>
        <div class="mt-auto d-grid gap-2">
          {% if film.disponibles %}
          <form method="post" action="{{ url_for('emprunter') }}" class="d-grid">
            <input type="hidden" name="film_id" value="{{ film.id }}">
            <button class="btn btn-primary btn-sm">Emprunter</button>
          </form>
          {% endif %}
          <form method="post" action="{{ url_for('ajouter_exemplaire') }}" class="d-grid">
            <input type="hidden" name="film_id" value="{{ film.id }}">
            <button class="btn btn-outline-secondary btn-sm">J'ai ce film</button>
          </form>
        </div>
      </div>
    </div>
  </article>
  {% endfor %}
</div>
{% elif not erreur %}
<p class="text-muted">{% if q %}Aucun film ne correspond à « {{ q }} ».{% else %}Aucun film dans le catalogue.{% endif %}</p>
{% endif %}
{% endif %}
{% endblock %}
