{% extends "base.j2" %}
{% import "_film.j2" as f %}
{% block content %}
{% if not connecte %}
<div class="relative overflow-hidden rounded-2xl bg-slate-950 p-8 text-white shadow-xl sm:p-12">
  <div class="absolute -right-16 -top-20 h-64 w-64 rounded-full bg-brand-600/30 blur-3xl"></div>
  <div class="relative max-w-2xl">
    <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-indigo-300">Votre cinéma, autrement</p>
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">Partagez vos films.<br><span class="text-indigo-300">Découvrez-en d'autres.</span></h1>
    <p class="my-5 max-w-xl text-lg leading-8 text-slate-300">Déclarez les films que vous possédez et empruntez ceux des autres membres de la vidéothèque.</p>
    <a class="inline-block rounded-lg bg-brand-500 px-5 py-3 font-semibold shadow-lg shadow-indigo-950/30 hover:bg-brand-400" href="{{ url_for('register') }}">Créer un compte</a>
    <a class="ml-2 inline-block rounded-lg border border-slate-600 px-5 py-3 font-medium hover:bg-white/10" href="{{ url_for('login') }}">Se connecter</a>
  </div>
</div>
{% else %}
<div class="mb-6 flex flex-wrap items-end justify-between gap-3">
  <h1 class="text-2xl font-bold tracking-tight">Catalogue <span class="text-sm font-normal text-slate-500">{{ films | length }} film{{ 's' if films | length > 1 }}</span></h1>
  <form method="get" class="rounded-xl border border-slate-200 bg-white/80 p-2 shadow-sm backdrop-blur sm:flex sm:flex-wrap sm:items-center" role="search">
    <input type="search" name="q" value="{{ q }}" class="rounded-lg border-0 bg-transparent px-3 py-2 placeholder:text-slate-400" placeholder="Rechercher un titre…" aria-label="Rechercher un titre" maxlength="100">
    <select name="genre" class="rounded-lg border-0 bg-transparent px-3 py-2" aria-label="Genre">
      <option value="">Tous les genres</option>
      {% for g in genres %}<option {{ 'selected' if g == genre }}>{{ g }}</option>{% endfor %}
    </select>
    <div class="flex items-center gap-2">
      <input class="h-4 w-4" type="checkbox" name="dispo" value="1" id="dispo" {{ 'checked' if dispo }}>
      <label for="dispo">Disponibles</label>
    </div>
    <button class="rounded-lg bg-brand-600 px-4 py-2 font-medium text-white hover:bg-brand-500">Filtrer</button>
    {% if q or genre or dispo %}<a class="rounded-lg px-4 py-2 text-sm text-slate-500 hover:bg-slate-100 hover:text-slate-900" href="{{ url_for('index') }}">Effacer</a>{% endif %}
  </form>
</div>

{% if films %}
<div class="grid grid-cols-2 gap-6 md:grid-cols-3 lg:grid-cols-5">
  {% for film in films %}
  <article>
    <div class="flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-xl">
      <a href="{{ url_for('film', film_id=film.id) }}">
        {% if film.affiche %}
        <img src="{{ film.affiche }}" class="affiche w-full" alt="Affiche de {{ film.titre }}" loading="lazy">
        {% else %}
        <div class="affiche-vide flex items-center justify-center bg-slate-200 text-slate-500">Pas d'affiche</div>
        {% endif %}
      </a>
      <div class="flex flex-1 flex-col p-4">
        <h2 class="mb-1 font-semibold"><a class="hover:text-blue-600" href="{{ url_for('film', film_id=film.id) }}">{{ film.titre }}</a></h2>
        <p class="mb-2 text-sm text-slate-500">{{ film.annee }}{% if film.genres %} · {{ film.genres[:2] | join(', ') }}{% endif %}</p>
        <p class="mb-3">{{ f.statut(film) }}</p>
        <div class="mt-auto grid gap-2">{{ f.actions(film) }}</div>
      </div>
    </div>
  </article>
  {% endfor %}
</div>
{% elif not erreur %}
<p class="text-slate-500">Aucun film ne correspond à ces critères.</p>
{% endif %}
{% endif %}
{% endblock %}
