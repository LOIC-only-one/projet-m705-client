{% extends "base.j2" %}
{% import "_film.j2" as f %}
{% block content %}
{% if not connecte %}
<div class="p-5 bg-white rounded shadow-sm">
  <h1 class="display-6">Bienvenue à la vidéothèque</h1>
  <p class="lead text-muted">Déclarez les films que vous possédez et empruntez ceux des autres membres.</p>
  <a class="btn btn-primary" href="{{ url_for('register') }}">Créer un compte</a>
  <a class="btn btn-outline-secondary" href="{{ url_for('login') }}">Se connecter</a>
</div>
{% else %}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
  <h1 class="h3 m-0">Catalogue <span class="text-muted fs-6">{{ films | length }} film{{ 's' if films | length > 1 }}</span></h1>
  <form method="get" class="d-flex flex-wrap align-items-center gap-2" role="search">
    <input type="search" name="q" value="{{ q }}" class="form-control w-auto" placeholder="Rechercher un titre…" aria-label="Rechercher un titre" maxlength="100">
    <select name="genre" class="form-select w-auto" aria-label="Genre">
      <option value="">Tous les genres</option>
      {% for g in genres %}<option {{ 'selected' if g == genre }}>{{ g }}</option>{% endfor %}
    </select>
    <div class="form-check mb-0">
      <input class="form-check-input" type="checkbox" name="dispo" value="1" id="dispo" {{ 'checked' if dispo }}>
      <label class="form-check-label" for="dispo">Disponibles</label>
    </div>
    <button class="btn btn-primary">Filtrer</button>
    {% if q or genre or dispo %}<a class="btn btn-outline-secondary" href="{{ url_for('index') }}">Effacer</a>{% endif %}
  </form>
</div>

{% if films %}
<div class="row row-cols-2 row-cols-md-3 row-cols-lg-5 g-4">
  {% for film in films %}
  <article class="col">
    <div class="card h-100 shadow-sm">
      <a href="{{ url_for('film', film_id=film.id) }}">
        {% if film.affiche %}
        <img src="{{ film.affiche }}" class="card-img-top affiche" alt="Affiche de {{ film.titre }}" loading="lazy">
        {% else %}
        <div class="card-img-top affiche-vide bg-secondary-subtle d-flex align-items-center justify-content-center text-muted">Pas d'affiche</div>
        {% endif %}
      </a>
      <div class="card-body d-flex flex-column">
        <h2 class="h6 card-title mb-1"><a class="link-body-emphasis text-decoration-none" href="{{ url_for('film', film_id=film.id) }}">{{ film.titre }}</a></h2>
        <p class="card-text text-muted small mb-2">{{ film.annee }}{% if film.genres %} · {{ film.genres[:2] | join(', ') }}{% endif %}</p>
        <p class="mb-3">{{ f.statut(film) }}</p>
        <div class="mt-auto d-grid gap-2">{{ f.actions(film) }}</div>
      </div>
    </div>
  </article>
  {% endfor %}
</div>
{% elif not erreur %}
<p class="text-muted">Aucun film ne correspond à ces critères.</p>
{% endif %}
{% endif %}
{% endblock %}
