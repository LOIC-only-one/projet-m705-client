{% extends "base.j2" %}
{% import "_film.j2" as f %}
{% block content %}
{% if not connecte %}
<div class="animate-fade-up rounded-md border border-slate-300 bg-white p-8 sm:p-12">
  <div class="max-w-2xl">
    <h1 class="text-3xl font-semibold sm:text-4xl">Votre vidéothèque partagée</h1>
    <p class="my-5 text-lg text-slate-600">Déclarez les films que vous possédez et empruntez ceux des autres membres.</p>
    <a class="ui-action inline-block rounded-md bg-blue-600 px-4 py-2 font-medium text-white hover:bg-blue-700" href="{{ url_for('register') }}">Créer un compte</a>
    <a class="ui-action ml-2 inline-block rounded-md border border-slate-300 px-4 py-2 font-medium hover:bg-slate-50" href="{{ url_for('login') }}">Se connecter</a>
  </div>
</div>
{% else %}
<div class="animate-fade-up mb-6 flex items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold">Films à découvrir</h1>
    <p class="mt-1 text-slate-600">Une sélection de films de la vidéothèque.</p>
  </div>
  <a class="ui-action rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium hover:bg-slate-50" href="{{ url_for('catalogue') }}">Voir tout le catalogue</a>
</div>

{% for section in sections %}
<section class="mb-8">
  <h2 class="mb-3 text-lg font-semibold">Sélection {{ loop.index }}</h2>
  <div class="grid grid-cols-2 gap-6 md:grid-cols-3 lg:grid-cols-5">
    {% for film in section %}
    <article class="film-card" style="animation-delay: {{ [loop.index0 * 55, 500] | min }}ms">
      <div class="flex h-full flex-col overflow-hidden rounded-md border border-slate-300 bg-white">
        <a class="poster-link" href="{{ url_for('film', film_id=film.id) }}">
          {% if film.affiche %}<img src="{{ film.affiche }}" class="affiche w-full" alt="Affiche de {{ film.titre }}" loading="lazy">
          {% else %}<div class="affiche-vide flex items-center justify-center bg-slate-200 text-slate-500">Pas d'affiche</div>{% endif %}
        </a>
        <div class="flex flex-1 flex-col p-4">
          <h3 class="mb-1 font-semibold"><a class="hover:text-blue-600" href="{{ url_for('film', film_id=film.id) }}">{{ film.titre }}</a></h3>
          <p class="mb-2 text-sm text-slate-500">{{ film.annee }}</p>
          <p class="mb-3">{{ f.statut(film) }}</p>
          <div class="mt-auto grid gap-2">{{ f.actions(film) }}</div>
        </div>
      </div>
    </article>
    {% endfor %}
  </div>
</section>
{% else %}
<p class="text-slate-500">Aucun film disponible.</p>
{% endfor %}
{% endif %}
{% endblock %}
