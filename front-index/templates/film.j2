{% extends "base.j2" %}
{% import "_film.j2" as f %}
{% block title %}{{ film.titre if film else 'Film' }} · Vidéothèque{% endblock %}
{% block content %}
<a class="ui-action mb-5 inline-flex items-center gap-2 rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 hover:border-blue-300 hover:bg-blue-50 hover:text-blue-700" href="{{ url_for('index') }}">
  <span aria-hidden="true"></span> Retour au catalogue
</a>
{% if film %}
<div class="grid gap-8 md:grid-cols-3">
  <div>
    {% if film.affiche %}
    <img src="{{ film.affiche }}" class="affiche w-full border border-slate-300" alt="Affiche de {{ film.titre }}">
    {% else %}
    <div class="affiche-vide flex items-center justify-center rounded bg-slate-200 text-slate-500">Pas d'affiche</div>
    {% endif %}
    <div class="mt-4">{{ f.actions(film, possession=True) }}</div>
  </div>
  <div class="md:col-span-2">
    <h1 class="mb-1 text-2xl font-semibold">{{ film.titre }}</h1>
    <p class="text-slate-500">{{ film.annee }}</p>
    <p>{% for g in film.genres %}<a class="mr-1 inline-block rounded-full border border-slate-300 px-3 py-1 text-sm hover:bg-slate-50" href="{{ url_for('catalogue', genre=g) }}">{{ g }}</a>{% endfor %}</p>
    <p class="my-4">{{ f.statut(film) }}</p>
    <p class="text-lg text-slate-600">{{ film.synopsis or "Pas de synopsis disponible." }}</p>
    {% if film.bande_annonce %}
    <div class="mt-8">
      <h2 class="mb-3 text-lg font-semibold">Bande-annonce</h2>
      <div class="aspect-video overflow-hidden border border-slate-300 bg-slate-950">
        <iframe class="h-full w-full" src="{{ film.bande_annonce }}" title="Bande-annonce de {{ film.titre }}"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen loading="lazy"></iframe>
      </div>
    </div>
    {% endif %}
    <div class="mt-4 flex flex-wrap gap-2">{{ f.actions(film, taille="", possession=False) }}</div>
  </div>
</div>
{% endif %}
{% endblock %}
