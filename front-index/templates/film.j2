{% extends "base.j2" %}
{% import "_film.j2" as f %}
{% block title %}{{ film.titre if film else 'Film' }} · Vidéothèque{% endblock %}
{% block content %}
<a class="mb-4 inline-block text-blue-600 hover:underline" href="{{ url_for('index') }}">← Retour au catalogue</a>
{% if film %}
<div class="grid gap-8 md:grid-cols-3">
  <div>
    {% if film.affiche %}
    <img src="{{ film.affiche }}" class="affiche w-full rounded shadow" alt="Affiche de {{ film.titre }}">
    {% else %}
    <div class="affiche-vide flex items-center justify-center rounded bg-slate-200 text-slate-500">Pas d'affiche</div>
    {% endif %}
    <div class="mt-4">{{ f.actions(film, depuis="fiche", possession=True) }}</div>
  </div>
  <div class="md:col-span-2">
    <h1 class="mb-1 text-2xl font-semibold">{{ film.titre }}</h1>
    <p class="text-slate-500">{{ film.annee }}</p>
    <p>{% for g in film.genres %}<a class="mr-1 inline-block rounded-full border border-slate-300 px-3 py-1 text-sm hover:bg-slate-50" href="{{ url_for('index', genre=g) }}">{{ g }}</a>{% endfor %}</p>
    <p class="my-4">{{ f.statut(film) }}</p>
    <p class="text-lg text-slate-600">{{ film.synopsis or "Pas de synopsis disponible." }}</p>
    {% if film.bande_annonce %}
    <div class="mt-8">
      <h2 class="mb-3 text-lg font-semibold">Bande-annonce</h2>
      <div class="aspect-video overflow-hidden rounded-xl bg-slate-950 shadow-lg">
        <iframe class="h-full w-full" src="{{ film.bande_annonce }}" title="Bande-annonce de {{ film.titre }}"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen loading="lazy"></iframe>
      </div>
    </div>
    {% endif %}
    <div class="mt-4 flex flex-wrap gap-2">{{ f.actions(film, depuis="fiche", taille="", possession=False) }}</div>
  </div>
</div>
{% endif %}
{% endblock %}
