{% extends "base.j2" %}
{% block title %}Administration · Vidéothèque{% endblock %}
{% block content %}
<h1 class="h3 mb-4">Administration
  <span class="text-muted fs-6">{{ utilisateurs | length }} utilisateur{{ 's' if utilisateurs | length > 1 }}</span>
</h1>

{% if supprime %}<div class="alert alert-success">Utilisateur supprimé.</div>{% endif %}

<div class="row g-4">
  <div class="col-md-5 col-lg-4">
    <div class="list-group shadow-sm">
      {% for u in utilisateurs %}
      <a class="list-group-item list-group-item-action {{ 'active' if u.id == selection }}"
         href="{{ url_for('admin', user=u.id) }}" {% if u.id == selection %}aria-current="true"{% endif %}>
        <span class="fw-semibold">{{ u.username }}</span><br>
        <span class="small opacity-75">{{ u.email }}</span>
      </a>
      {% else %}
      <div class="list-group-item text-muted">Aucun utilisateur.</div>
      {% endfor %}
    </div>
  </div>

  <div class="col-md-7 col-lg-8">
    {% if selection %}
    <div class="card shadow-sm">
      <div class="card-body">
        <h2 class="h5 mb-1">Utilisateur</h2>
        <p class="font-monospace small text-muted mb-3">
          {{ selection }}{% if form.get('created_at') %} · inscrit le {{ form.get('created_at')[:10] }}{% endif %}
        </p>
        {% if modifie %}<div class="alert alert-success">Utilisateur mis à jour.</div>{% endif %}

        <form method="post" action="{{ url_for('admin_modifier_utilisateur', id=selection) }}">
          <div class="mb-3">
            <label for="username" class="form-label">Nom d'utilisateur</label>
            <input class="form-control" id="username" name="username" value="{{ form.get('username', '') }}" required
                   pattern="[A-Za-z0-9_.\-]{3,50}" autocomplete="off">
            <div class="form-text">3 à 50 caractères : lettres, chiffres, _ . -</div>
          </div>

          <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input type="email" class="form-control" id="email" name="email" value="{{ form.get('email', '') }}" required maxlength="255" autocomplete="off">
          </div>

          <div class="mb-3">
            <label for="birthdate" class="form-label">Date de naissance</label>
            <input type="date" class="form-control" id="birthdate" name="birthdate" value="{{ form.get('birthdate', '') }}" required>
          </div>

          <div class="mb-3">
            <label for="photo_profil" class="form-label">Photo de profil (URL)</label>
            <input type="text" class="form-control" id="photo_profil" name="photo_profil" value="{{ form.get('photo_profil') or '' }}">
            <div class="form-text">Laissez vide pour supprimer la photo.</div>
          </div>

          <div class="mb-3">
            <label for="role" class="form-label">Rôle</label>
            <select class="form-select" id="role" name="role">
              {% for r in ('user', 'admin') %}
              <option value="{{ r }}" {{ 'selected' if form.get('role') == r }}>{{ r }}</option>
              {% endfor %}
            </select>
            <div class="form-text">Le nouveau rôle s'applique à la prochaine connexion de l'utilisateur (jeton d'accès de 15 min).</div>
          </div>

          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">Enregistrer les modifications</button>
            {% if selection != moi %}{# un admin ne peut pas se supprimer lui-même #}
            <button type="submit" class="btn btn-outline-danger" formnovalidate
                    formaction="{{ url_for('admin_supprimer_utilisateur', id=selection) }}"
                    onclick="return confirm('Supprimer définitivement cet utilisateur ?')">Supprimer l'utilisateur</button>
            {% endif %}
          </div>
        </form>
      </div>
    </div>
    {% elif utilisateurs %}
    <p class="text-muted">Sélectionnez un utilisateur dans la liste pour afficher et modifier son compte.</p>
    {% endif %}
  </div>
</div>
{% endblock %}