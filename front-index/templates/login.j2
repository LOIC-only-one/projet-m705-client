{% extends "base.j2" %}
{% block title %}Connexion · Vidéothèque{% endblock %}
{% block content %}
<div class="mx-auto max-w-md">
  <div class="rounded-lg bg-white p-6 shadow">
        <h1 class="mb-4 text-xl font-semibold">Connexion</h1>
        {% if inscrit %}<div class="mb-4 rounded border border-green-200 bg-green-50 px-4 py-3 text-green-800">Compte créé, vous pouvez vous connecter.</div>{% endif %}
        <form method="post">
          <div class="mb-4">
            <label for="email" class="mb-1 block text-sm font-medium">Email</label>
            <input type="email" class="w-full rounded border border-slate-300 px-3 py-2" id="email" name="email" value="{{ email }}" required autocomplete="email">
          </div>
          <div class="mb-4">
            <label for="password" class="mb-1 block text-sm font-medium">Mot de passe</label>
            <input type="password" class="w-full rounded border border-slate-300 px-3 py-2" id="password" name="password" required autocomplete="current-password">
          </div>
          <button type="submit" class="w-full rounded bg-blue-600 px-4 py-2 text-white hover:bg-blue-500">Se connecter</button>
        </form>
        <p class="mt-4 text-center text-sm">Pas de compte ? <a class="text-blue-600 hover:underline" href="{{ url_for('register') }}">Inscription</a></p>
  </div>
</div>
{% endblock %}
