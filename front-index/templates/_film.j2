{# Statut et actions d'un film, partagés entre le catalogue et la fiche film. #}
{% macro statut(film) %}
  {% if film.possede %}<span class="text-sm font-medium text-blue-700">Dans ma vidéothèque</span>
  {% elif film.emprunte %}<span class="text-sm font-medium text-cyan-700">Emprunté</span>
  {% elif film.disponibles %}<span class="text-sm font-medium text-green-700">{{ film.disponibles }} disponible{{ 's' if film.disponibles > 1 }}</span>
  {% else %}<span class="text-sm text-slate-600">Indisponible</span>
  {% endif %}
{% endmacro %}

{% macro actions(film, depuis="catalogue", taille="", possession=True) %}
  {% if film.emprunte %}
  <a class="ui-action border border-cyan-500 px-3 py-1.5 text-sm text-cyan-700 hover:bg-cyan-50 {{ taille }}" href="{{ url_for('videotheque') }}">Voir mes emprunts</a>
  {% elif not film.possede %}
    {% if film.disponibles %}
    <form method="post" action="{{ url_for('emprunter') }}" class="grid">
      <input type="hidden" name="film_id" value="{{ film.id }}"><input type="hidden" name="depuis" value="{{ depuis }}">
      <button class="ui-action bg-blue-600 px-3 py-2 text-sm font-medium text-white hover:bg-blue-700 {{ taille }}">Emprunter</button>
    </form>
    {% endif %}
    {% if possession %}<form method="post" action="{{ url_for('ajouter_exemplaire') }}" class="grid">
      <input type="hidden" name="film_id" value="{{ film.id }}"><input type="hidden" name="depuis" value="{{ depuis }}">
      <button class="ui-action border border-slate-300 px-3 py-2 text-sm font-medium hover:bg-slate-50 {{ taille }}">J'ai ce film</button>
    </form>{% endif %}
  {% endif %}
{% endmacro %}
