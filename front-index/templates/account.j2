{% extends "base.j2" %}
{% block title %}Mon compte · Vidéothèque{% endblock %}
{% block content %}
<div class="mx-auto max-w-xl">
    <div class="rounded-lg bg-white p-6 shadow">
        <div class="mb-5 flex items-center justify-between">
          <h1 class="text-xl font-semibold">Mon compte</h1>
          <!-- Bouton pour activer l'édition de tous les champs -->
          <button type="button" class="rounded border border-slate-300 px-3 py-1.5 text-sm hover:bg-slate-50" id="enable-edit-btn" onclick="toggleEditMode()">
            Modifier le profil
          </button>
        </div>


        <form method="POST">
          <div class="mb-4">
            <label for="username" class="mb-1 block text-sm font-medium">Nom d'utilisateur</label>
            <input class="editable-field w-full rounded border border-slate-300 px-3 py-2 disabled:bg-slate-100" id="username" name="username" value="{{ form.get('username', '') }}" required
                   pattern="[A-Za-z0-9_.\-]{3,50}" autocomplete="username" disabled>
            <div class="mt-1 text-sm text-slate-500">3 à 50 caractères : lettres, chiffres, _ . -</div>
          </div>

          <div class="mb-4">
            <label for="email" class="mb-1 block text-sm font-medium">Email</label>
            <input type="email" class="editable-field w-full rounded border border-slate-300 px-3 py-2 disabled:bg-slate-100" id="email" name="email" value="{{ form.get('email', '') }}" required maxlength="255" autocomplete="email" disabled>
          </div>

          <div class="mb-4">
            <label for="birthdate" class="mb-1 block text-sm font-medium">Date de naissance</label>
            <input type="date" class="editable-field w-full rounded border border-slate-300 px-3 py-2 disabled:bg-slate-100" id="birthdate" name="birthdate" value="{{ form.get('birthdate', '') }}" required disabled>
          </div>

          <div class="mb-4">
            <label for="photo_profil" class="mb-1 block text-sm font-medium">Photo de profil (URL)</label>
            <input type="text" class="editable-field w-full rounded border border-slate-300 px-3 py-2 disabled:bg-slate-100" id="photo_profil" name="photo_profil" value="{{ form.get('photo_profil') or '' }}" disabled>
          </div>

          <div class="mb-4">
            <label for="password" class="mb-1 block text-sm font-medium">Mot de passe</label>
            <input type="password" class="editable-field w-full rounded border border-slate-300 px-3 py-2 disabled:bg-slate-100" id="password" name="password" required minlength="12" autocomplete="new-password" placeholder="************" disabled>
            <div class="mt-1 text-sm text-slate-500">12 caractères minimum.</div>
          </div>

          <!-- Bouton Enregistrer (caché par défaut) -->
          <div id="save-container" class="hidden">
            <button type="submit" class="w-full rounded bg-blue-600 px-4 py-2 text-white hover:bg-blue-500">Enregistrer les modifications</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
function toggleEditMode() {
    const fields = document.querySelectorAll('.editable-field');
    const saveContainer = document.getElementById('save-container');
    const editBtn = document.getElementById('enable-edit-btn');
    
    fields.forEach(field => {
        field.disabled = !field.disabled;
    });

    saveContainer.classList.toggle('hidden');
    
    if (saveContainer.classList.contains('hidden')) {
        editBtn.innerHTML = 'Modifier le profil';
        editBtn.classList.replace('border-red-300', 'border-slate-300');
    } else {
        editBtn.innerHTML = 'Annuler';
        editBtn.classList.replace('border-slate-300', 'border-red-300');
    }
}
</script>
{% endblock %}