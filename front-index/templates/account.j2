{% extends "base.j2" %}
{% block title %}Mon compte · Vidéothèque{% endblock %}
{% block content %}
<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h1 class="h4 m-0">Mon compte</h1>
          <!-- Bouton pour activer l'édition de tous les champs -->
          <button type="button" class="btn btn-outline-secondary btn-sm" id="enable-edit-btn" onclick="toggleEditMode()">
            <i class="bi bi-pencil"></i> Modifier le profil
          </button>
        </div>

        {% if erreur %}
          <div class="alert alert-danger" role="alert">{{ erreur }}</div>
        {% endif %}

        <form method="POST">
          <div class="mb-3">
            <label for="username" class="form-label">Nom d'utilisateur</label>
            <input class="form-control editable-field" id="username" name="username" value="{{ form.get('username', '') }}" required
                   pattern="[A-Za-z0-9_.\-]{3,50}" autocomplete="username" disabled>
            <div class="form-text">3 à 50 caractères : lettres, chiffres, _ . -</div>
          </div>

          <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input type="email" class="form-control editable-field" id="email" name="email" value="{{ form.get('email', '') }}" required maxlength="255" autocomplete="email" disabled>
          </div>

          <div class="mb-3">
            <label for="password" class="form-label">Nouveau mot de passe <small class="text-muted">(Laisser vide si inchangé)</small></label>
            <input type="password" class="form-control editable-field" id="password" name="password" minlength="12" autocomplete="new-password" disabled>
          </div>

          <div class="mb-3">
            <label for="birthdate" class="form-label">Date de naissance</label>
            <input type="date" class="form-control editable-field" id="birthdate" name="birthdate" value="{{ form.get('birthdate', '') }}" required disabled>
          </div>

          <div class="mb-3">
            <label for="photo_profil" class="form-label">Photo de profil (URL)</label>
            <input type="text" class="form-control editable-field" id="photo_profil" name="photo_profil" value="{{ form.get('photo_profil', '') }}" disabled>
          </div>

          <!-- Champ caché pour conserver le rôle existant lors du POST -->
          <input type="hidden" name="role" value="{{ form.get('role', 'user') }}">

          <!-- Bouton Enregistrer (caché par défaut) -->
          <div id="save-container" class="d-none">
            <button type="submit" class="btn btn-primary w-100">Enregistrer les modifications</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
function toggleEditMode() {
    const fields = document.querySelectorAll('.editable-field');
    const saveContainer = document.getElementById('save-container');
    const editBtn = document.getElementById('enable-edit-btn');
    
    fields.forEach(field => {
        field.disabled = !field.disabled;
    });

    saveContainer.classList.toggle('d-none');
    
    if (saveContainer.classList.contains('d-none')) {
        editBtn.innerHTML = 'Modifier le profil';
        editBtn.classList.replace('btn-outline-danger', 'btn-outline-secondary');
    } else {
        editBtn.innerHTML = 'Annuler';
        editBtn.classList.replace('btn-outline-secondary', 'btn-outline-danger');
    }
}
</script>
{% endblock %}